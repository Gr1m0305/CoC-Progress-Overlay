<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:ClashOverlay.App.ViewModels">

    <DataTemplate DataType="{x:Type vm:MessageTab}">
        <TextBlock Style="{StaticResource Subtle}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Message}" />
    </DataTemplate>
</ResourceDictionary>
