<UserControl x:Class="ClashOverlay.App.Views.OverlayView" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:ClashOverlay.App.Views"
             xmlns:vm="clr-namespace:ClashOverlay.App.ViewModels"
             xmlns:data="clr-namespace:ClashOverlay.Core.Data;assembly=ClashOverlay.Core"
             Width="1260" Height="760"
             FontFamily="{StaticResource Inter}"
             TextOptions.TextFormattingMode="Ideal"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Tabs.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <v:EqualsParameter x:Key="Is" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Border x:Name="Root" CornerRadius="{StaticResource PanelRadius}" Background="{Binding PanelBrush}"
            BorderBrush="#2AFFFFFF" BorderThickness="1" ClipToBounds="True">
        <Grid>
            <!-- soft sheen at the top of the glass -->
            <Border CornerRadius="{StaticResource PanelRadius}" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#12FFFFFF" Offset="0" />
                        <GradientStop Color="#00FFFFFF" Offset="0.22" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Grid Margin="22,14,22,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="56" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- account chip -->
                    <Button Grid.Column="0" Style="{StaticResource FlatButton}" Padding="6,4,10,4" Command="{Binding ToggleAccountMenuCommand}"
                            Background="{StaticResource CardBrush}" ToolTip="Switch account (Ctrl+Tab, Ctrl+1…9)">
                        <StackPanel Orientation="Horizontal">
                            <v:ItemImage Width="38" Height="38" Source="{Binding AccountImage}" Text="{Binding AccountName}" />
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center" MinWidth="120">
                                <TextBlock Style="{StaticResource Strong}" FontSize="15" Text="{Binding AccountName}" MaxWidth="220" />
                                <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                    <TextBlock Style="{StaticResource Muted}" Text="{Binding AccountTag}" />
                                    <TextBlock Style="{StaticResource Muted}" Text="  ·  " Visibility="{Binding AccountHall, Converter={x:Static v:VisibleIf.Instance}}" />
                                    <TextBlock Style="{StaticResource Muted}" Text="{Binding AccountHall}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                                </StackPanel>
                            </StackPanel>
                            <Path Margin="12,0,2,0" VerticalAlignment="Center" Data="M0,0 L5,5 L10,0" Stroke="{StaticResource SubtleTextBrush}" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </StackPanel>
                    </Button>

                    <!-- village switch -->
                    <Border Grid.Column="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segment}" Content="Main Village" GroupName="village"
                                         IsChecked="{Binding Village, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter=Home}"
                                         Command="{Binding ShowVillageCommand}" CommandParameter="{x:Static data:Village.Home}" />
                            <RadioButton Style="{StaticResource Segment}" Content="Builder Base" GroupName="village"
                                         IsChecked="{Binding Village, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter=BuilderBase}"
                                         Command="{Binding ShowVillageCommand}" CommandParameter="{x:Static data:Village.BuilderBase}" />
                        </StackPanel>
                    </Border>

                    <!-- sync status and hotkeys -->
                    <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" ToolTip="{Binding SyncTooltip}" Background="Transparent">
                            <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource GreenBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SyncWarning}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource OrangeBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding SyncText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Subtle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SyncWarning}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource OrangeBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Muted}" HorizontalAlignment="Right" Margin="0,3,0,0" Text="{Binding HotkeyHints}" />
                    </StackPanel>

                    <Button Grid.Column="5" Style="{StaticResource FlatButton}" Width="34" Height="34" Padding="0" Command="{Binding CloseCommand}" ToolTip="Close (Esc)">
                        <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{StaticResource SubtleTextBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Button>
                </Grid>

                <!-- Tabs -->
                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <ListBox ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource TabItem}" Focusable="False" DisplayMemberPath="Title"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Subtle}" Foreground="{StaticResource OrangeBrush}" Text="{Binding Notice}" MaxWidth="560" Margin="0,0,10,0"
                                   ToolTip="{Binding Notice}" Visibility="{Binding Notice, Converter={x:Static v:VisibleIf.Instance}}" />
                        <TextBlock Style="{StaticResource Muted}" Text="Updating…" Visibility="{Binding IsLoading, Converter={x:Static v:VisibleIf.Instance}}" />
                    </StackPanel>
                    <Border Height="1" VerticalAlignment="Bottom" Background="{StaticResource DividerBrush}" />
                </Grid>

                <!-- Selected tab -->
                <ContentControl Grid.Row="2" Margin="0,16,0,8" Content="{Binding SelectedTab}" Focusable="False" />

                <!-- Footer -->
                <Grid Grid.Row="3">
                    <TextBlock Style="{StaticResource Muted}" FontSize="10.5" Text="Clash Tracker · Not affiliated with, endorsed, sponsored or approved by Supercell." />
                    <Border Style="{StaticResource Badge}" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Right"
                            Visibility="{Binding IsDemo, Converter={x:Static v:VisibleIf.Instance}}">
                        <TextBlock Style="{StaticResource BadgeText}" Foreground="{DynamicResource AccentBrush}" FontSize="10" Text="DEMO DATA" />
                    </Border>
                </Grid>
            </Grid>

            <!-- Account switcher: a click outside closes it -->
            <Border Background="#01000000" Visibility="{Binding IsAccountMenuOpen, Converter={x:Static v:VisibleIf.Instance}}"
                    MouseLeftButtonDown="OnOutsideAccountMenu" />
            <Border Margin="22,74,0,0" Width="340" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Background="#F5161B24" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="12" Padding="8"
                    Visibility="{Binding IsAccountMenuOpen, Converter={x:Static v:VisibleIf.Instance}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.5" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Margin="8,4,0,6" Text="ACCOUNTS" />
                    <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount, Mode=OneWay}" MaxHeight="420">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:AccountItemViewModel}">
                                <Grid Background="Transparent" Height="48">
                                    <Grid.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.PickAccountCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                      CommandParameter="{Binding}" />
                                    </Grid.InputBindings>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <v:ItemImage Width="36" Height="36" Source="{Binding HallImage}" Text="{Binding Name}" />
                                    <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Strong}" Text="{Binding Name}" />
                                        <TextBlock Style="{StaticResource Muted}" Text="{Binding Detail}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock Style="{StaticResource Subtle}" HorizontalAlignment="Right" FontWeight="SemiBold" Text="{Binding Hall}" />
                                        <TextBlock Style="{StaticResource Muted}" HorizontalAlignment="Right" Text="{Binding KeyHint}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Border Width="3" HorizontalAlignment="Left" Margin="-8,8,0,8" CornerRadius="1.5" Background="{DynamicResource AccentBrush}"
                                            Visibility="{Binding IsSelected, Converter={x:Static v:VisibleIf.Instance}}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Style="{StaticResource Muted}" Margin="8,8,8,4" TextWrapping="Wrap" Text="Add or remove accounts in Settings. Ctrl+Tab cycles; Ctrl+1…9 jumps." />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
