<Project>
  <!--
    The release build: one self-contained ClashOverlay.exe for 64-bit Windows (no .NET install needed), with the
    Inter licence beside it in licenses\. Used by the release workflow and for local builds:
      dotnet publish src/ClashOverlay.App -p:PublishProfile=win-x64
  -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\publish\</PublishDir>
  </PropertyGroup>
</Project>
