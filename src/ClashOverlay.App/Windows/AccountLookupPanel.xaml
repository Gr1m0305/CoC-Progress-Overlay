<UserControl x:Class="ClashOverlay.App.Windows.AccountLookupPanel" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:ClashOverlay.App.Views">
    <UserControl.Resources>
        <v:VisibleIf x:Key="Vis" />
    </UserControl.Resources>
    <!-- DataContext: AccountLookupViewModel -->
    <StackPanel>
        <DockPanel>
            <Button DockPanel.Dock="Right" Margin="10,0,0,0" Style="{StaticResource SecondaryButton}" Content="Look up" Command="{Binding LookUpCommand}" IsDefault="True" />
            <TextBox x:Name="TagBox" Style="{StaticResource Input}" Tag="#2PP0JQ9Y8" Text="{Binding TagText, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>
        <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" Text="Looking up…" Visibility="{Binding IsBusy, Converter={StaticResource Vis}}" />
        <TextBlock Margin="0,8,0,0" Style="{StaticResource Body}" Foreground="{StaticResource ProblemBrush}" Text="{Binding Problem}" Visibility="{Binding Problem, Converter={StaticResource Vis}}" />
        <Button Margin="0,6,0,0" HorizontalAlignment="Left" Style="{StaticResource LinkButton}" Content="Add it anyway (check the tag later)" Command="{Binding AddAnywayCommand}"
                Visibility="{Binding CanAddAnyway, Converter={StaticResource Vis}}" />

        <Border Margin="0,12,0,0" Style="{StaticResource Panel}" Visibility="{Binding HasPreview, Converter={StaticResource Vis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource PrimaryButton}" Content="Add account" Command="{Binding AddCommand}" />
                <Image DockPanel.Dock="Left" Width="52" Height="52" Margin="0,0,14,0" Source="{Binding HallImage}" RenderOptions.BitmapScalingMode="HighQuality" />
                <Image DockPanel.Dock="Left" Width="40" Height="40" Margin="0,0,14,0" Source="{Binding LeagueImage}" RenderOptions.BitmapScalingMode="HighQuality"
                       Visibility="{Binding LeagueImage, Converter={StaticResource Vis}}" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Strong}" FontSize="14" Text="{Binding PreviewTitle}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,3,0,0" Text="{Binding PreviewDetail}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0" Text="{Binding PreviewClan}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </StackPanel>
</UserControl>
