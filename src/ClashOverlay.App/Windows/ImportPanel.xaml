<UserControl x:Class="ClashOverlay.App.Windows.ImportPanel" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:ClashOverlay.App.Views">
    <UserControl.Resources>
        <v:VisibleIf x:Key="Vis" />
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Style="{StaticResource Body}" Text="{Binding Steps}" />

        <!-- which account (only with several) -->
        <ListBox Margin="0,14,0,0" ItemsSource="{Binding Accounts}" SelectedItem="{Binding Account}" Background="Transparent" BorderThickness="0"
                 ItemContainerStyle="{StaticResource NavItem}" Visibility="{Binding ManyAccounts, Converter={StaticResource Vis}}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" />
                        <TextBlock Margin="6,0,0,0" Foreground="{StaticResource MutedTextBrush}" FontWeight="Normal" Text="{Binding Tag}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border x:Name="DropZone" Margin="0,14,0,0" Padding="18,22" CornerRadius="12" AllowDrop="True" Background="#0AFFFFFF"
                DragEnter="OnDragOver" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop">
            <Border.BorderBrush>
                <DrawingBrush Viewport="0,0,10,10" ViewportUnits="Absolute" TileMode="Tile">
                    <DrawingBrush.Drawing>
                        <GeometryDrawing Brush="#40FFFFFF">
                            <GeometryDrawing.Geometry>
                                <GeometryGroup>
                                    <RectangleGeometry Rect="0,0,5,5" />
                                    <RectangleGeometry Rect="5,5,5,5" />
                                </GeometryGroup>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Border.BorderBrush>
            <Border.BorderThickness>1.5</Border.BorderThickness>
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Style="{StaticResource Strong}" FontSize="14" HorizontalAlignment="Center" Text="Drop the export file here" />
                <TextBlock Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,4,0,12" Text="or" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource PrimaryButton}" Content="Paste from clipboard" Command="{Binding PasteCommand}" />
                    <Button Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Content="Choose file…" Command="{Binding ChooseFileCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Text="{Binding Result}" Visibility="{Binding Result, Converter={StaticResource Vis}}">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Strong}">
                    <Setter Property="Foreground" Value="{StaticResource ProblemBrush}" />
                    <Setter Property="TextTrimming" Value="None" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Ok}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Text="{Binding CurrentExport}" />
    </StackPanel>
</UserControl>
