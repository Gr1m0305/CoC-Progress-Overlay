<w:AppWindow x:Class="ClashOverlay.App.Windows.ImportWindow" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:w="clr-namespace:ClashOverlay.App.Windows"
             Title="Import village export" Width="600" SizeToContent="Height" ResizeMode="NoResize">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="24,12">
            <Button HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}" MinWidth="90" Content="Done" IsCancel="True" Click="OnDone" />
        </Border>
        <StackPanel Margin="26,22,26,22">
            <TextBlock Style="{StaticResource PageTitle}" Margin="0,0,0,10" Text="Import village export" />
            <w:ImportPanel />
        </StackPanel>
    </DockPanel>
</w:AppWindow>
